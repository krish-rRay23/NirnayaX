# NirnayaX environment configuration (EXAMPLE — copy to .env and fill in).
# The real .env is git-ignored and must never be committed.
#
# NOTE: These integrations are consumed in LATER phases. Phase 1 (domain + data
# foundation) does not read any of them; they are documented here for continuity.

# --- Jira (future ticketing integration) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_KEY=KAN

# --- LLM provider (future triage/RAG integration) ---
LLM_API_KEY=replace-me
